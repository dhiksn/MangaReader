PORT=3000

# Nama author / creator API yang akan otomatis disisipkan di response
API_AUTHOR=dhiksn

# CORS Origin (gunakan * atau domain spesifik seperti https://myfrontend.com)
CORS_ORIGIN=*

# Set true jika ingin mengizinkan proxy mengakses URL localhost/IP privat saat testing lokal
ALLOW_LOCAL_PROXY=false

# Kredensial akun Softkomik untuk mengakses konten kategori NSFW
SOFTKOMIK_EMAIL=
SOFTKOMIK_PASSWORD=

# Kredensial akun CrotPedia (diperlukan untuk membaca chapter)
CROTPEDIA_EMAIL=
CROTPEDIA_PASSWORD=

# Kredensial akun Holotoon (opsional/jika memiliki akun)
# Catatan: Karena holodek.run memproteksi endpoint login menggunakan Cloudflare Turnstile,
# Anda dapat memasukkan cookie sesi browser 'better-auth.session_token' secara langsung ke HOLOTOON_COOKIE
HOLOTOON_EMAIL=
HOLOTOON_PASSWORD=
HOLOTOON_COOKIE=
